{
  "ReviewRunConfig": {
    "additionalProperties": false,
    "properties": {
      "condition": {
        "enum": [
          "A",
          "B",
          "C",
          "D"
        ],
        "title": "Condition",
        "type": "string"
      },
      "run_kind": {
        "enum": [
          "formal",
          "preflight",
          "smoke",
          "warmup",
          "debug"
        ],
        "title": "Run Kind",
        "type": "string"
      },
      "provider": {
        "enum": [
          "gemini",
          "local",
          "mock"
        ],
        "title": "Provider",
        "type": "string"
      },
      "model_exact_id": {
        "minLength": 1,
        "title": "Model Exact Id",
        "type": "string"
      },
      "model_config_version": {
        "minLength": 1,
        "title": "Model Config Version",
        "type": "string"
      },
      "max_requests": {
        "minimum": 1,
        "title": "Max Requests",
        "type": "integer"
      },
      "max_total_tokens": {
        "minimum": 1,
        "title": "Max Total Tokens",
        "type": "integer"
      },
      "max_output_tokens": {
        "minimum": 1,
        "title": "Max Output Tokens",
        "type": "integer"
      },
      "max_prompt_chars": {
        "minimum": 1,
        "title": "Max Prompt Chars",
        "type": "integer"
      },
      "node_seconds": {
        "default": 1200,
        "exclusiveMinimum": 0,
        "maximum": 1200,
        "title": "Node Seconds",
        "type": "number"
      },
      "run_seconds": {
        "default": 5400,
        "exclusiveMinimum": 0,
        "maximum": 5400,
        "title": "Run Seconds",
        "type": "number"
      },
      "request_seconds": {
        "exclusiveMinimum": 0,
        "maximum": 1200,
        "title": "Request Seconds",
        "type": "number"
      },
      "transport_retries": {
        "default": 0,
        "maximum": 1,
        "minimum": 0,
        "title": "Transport Retries",
        "type": "integer"
      },
      "temperature": {
        "const": 0,
        "default": 0,
        "title": "Temperature",
        "type": "integer"
      },
      "context_tokens": {
        "const": 32768,
        "default": 32768,
        "title": "Context Tokens",
        "type": "integer"
      },
      "config_version": {
        "const": "review-run-v1-s2",
        "default": "review-run-v1-s2",
        "title": "Config Version",
        "type": "string"
      }
    },
    "required": [
      "condition",
      "run_kind",
      "provider",
      "model_exact_id",
      "model_config_version",
      "max_requests",
      "max_total_tokens",
      "max_output_tokens",
      "max_prompt_chars",
      "request_seconds"
    ],
    "title": "ReviewRunConfig",
    "type": "object"
  },
  "ComponentCritiqueReport": {
    "$defs": {
      "ReviewIssue": {
        "additionalProperties": false,
        "properties": {
          "issue_id": {
            "minLength": 1,
            "title": "Issue Id",
            "type": "string"
          },
          "severity": {
            "enum": [
              "low",
              "medium",
              "high",
              "critical"
            ],
            "title": "Severity",
            "type": "string"
          },
          "criterion": {
            "minLength": 1,
            "title": "Criterion",
            "type": "string"
          },
          "description": {
            "minLength": 1,
            "title": "Description",
            "type": "string"
          },
          "suggested_fix": {
            "minLength": 1,
            "title": "Suggested Fix",
            "type": "string"
          },
          "affected_claim_ids": {
            "items": {
              "type": "string"
            },
            "title": "Affected Claim Ids",
            "type": "array"
          },
          "source_ids": {
            "items": {
              "type": "string"
            },
            "title": "Source Ids",
            "type": "array"
          },
          "artifact_version": {
            "maximum": 2,
            "minimum": 1,
            "title": "Artifact Version",
            "type": "integer"
          }
        },
        "required": [
          "issue_id",
          "severity",
          "criterion",
          "description",
          "suggested_fix",
          "affected_claim_ids",
          "source_ids",
          "artifact_version"
        ],
        "title": "ReviewIssue",
        "type": "object"
      },
      "ReviewMetric": {
        "additionalProperties": false,
        "properties": {
          "criterion": {
            "minLength": 1,
            "title": "Criterion",
            "type": "string"
          },
          "score": {
            "maximum": 4,
            "minimum": 0,
            "title": "Score",
            "type": "integer"
          },
          "rationale": {
            "minLength": 1,
            "title": "Rationale",
            "type": "string"
          },
          "evidence_anchor": {
            "minLength": 1,
            "title": "Evidence Anchor",
            "type": "string"
          }
        },
        "required": [
          "criterion",
          "score",
          "rationale",
          "evidence_anchor"
        ],
        "title": "ReviewMetric",
        "type": "object"
      }
    },
    "additionalProperties": false,
    "properties": {
      "role": {
        "enum": [
          "research",
          "strategy",
          "finance",
          "final"
        ],
        "title": "Role",
        "type": "string"
      },
      "artifact_id": {
        "minLength": 1,
        "title": "Artifact Id",
        "type": "string"
      },
      "artifact_version": {
        "maximum": 2,
        "minimum": 1,
        "title": "Artifact Version",
        "type": "integer"
      },
      "metrics": {
        "items": {
          "$ref": "#/$defs/ReviewMetric"
        },
        "title": "Metrics",
        "type": "array"
      },
      "issues": {
        "items": {
          "$ref": "#/$defs/ReviewIssue"
        },
        "title": "Issues",
        "type": "array"
      }
    },
    "required": [
      "role",
      "artifact_id",
      "artifact_version",
      "metrics",
      "issues"
    ],
    "title": "ComponentCritiqueReport",
    "type": "object"
  },
  "CallEventPayload": {
    "$defs": {
      "ArtifactRef": {
        "additionalProperties": false,
        "properties": {
          "artifact_id": {
            "title": "Artifact Id",
            "type": "string"
          },
          "artifact_version": {
            "title": "Artifact Version",
            "type": "integer"
          },
          "sha256": {
