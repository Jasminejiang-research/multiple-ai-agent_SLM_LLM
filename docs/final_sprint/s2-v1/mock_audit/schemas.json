      "planned_id",
      "run_kind",
      "logical_task_id",
      "node_scope_id",
      "batch_id",
      "attempt_id",
      "attempt_index",
      "role",
      "task_role",
      "purpose",
      "task_purpose",
      "transport_retry_of",
      "provider",
      "model_exact_id",
      "model_config_version",
      "config_sha256",
      "prompt_hash",
      "schema_hash",
      "evidence_hash",
      "input_artifact_refs",
      "output_artifact_ref",
      "started_at_utc",
      "ended_at_utc",
      "elapsed_seconds",
      "status",
      "error_type",
      "usage_raw",
      "prompt_tokens",
      "output_tokens",
      "total_tokens",
      "usage_missing_reason",
      "budget_before",
      "budget_after",
      "reservation_tokens"
