      "budget_before": {
        "additionalProperties": true,
        "title": "Budget Before",
        "type": "object"
      },
      "budget_after": {
        "additionalProperties": true,
        "title": "Budget After",
        "type": "object"
      },
      "reservation_tokens": {
        "title": "Reservation Tokens",
        "type": "integer"
      },
      "budget_token_charge": {
        "anyOf": [
          {
            "type": "integer"
          },
          {
            "type": "null"
          }
