        "type": "string"
      },
      "task_purpose": {
        "enum": [
          "generate",
          "critic",
          "revision"
        ],
        "title": "Task Purpose",
        "type": "string"
      },
      "transport_retry_of": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "type": "null"
          }
        ],
        "title": "Transport Retry Of"
      },
      "provider": {
        "title": "Provider",
        "type": "string"
      },
      "model_exact_id": {
        "title": "Model Exact Id",
        "type": "string"
      },
      "model_config_version": {
        "title": "Model Config Version",
        "type": "string"
      },
      "config_sha256": {
        "title": "Config Sha256",
        "type": "string"
      },
      "prompt_hash": {
        "title": "Prompt Hash",
        "type": "string"
      },
      "schema_hash": {
        "title": "Schema Hash",
        "type": "string"
      },
      "evidence_hash": {
        "title": "Evidence Hash",
        "type": "string"
      },
      "input_artifact_refs": {
        "items": {
          "$ref": "#/$defs/ArtifactRef"
        },
        "title": "Input Artifact Refs",
        "type": "array"
      },
      "output_artifact_ref": {
        "anyOf": [
          {
            "additionalProperties": true,
            "type": "object"
          },
          {
            "type": "null"
          }
        ],
        "title": "Output Artifact Ref"
      },
      "started_at_utc": {
        "title": "Started At Utc",
        "type": "string"
      },
      "ended_at_utc": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "type": "null"
          }
        ],
        "title": "Ended At Utc"
      },
      "elapsed_seconds": {
        "anyOf": [
          {
            "type": "number"
          },
          {
            "type": "null"
          }
        ],
        "title": "Elapsed Seconds"
      },
      "status": {
        "enum": [
          "dispatching",
          "succeeded",
          "failed",
          "timeout",
          "cancelled",
          "invalid_output",
          "interrupted_unknown"
        ],
