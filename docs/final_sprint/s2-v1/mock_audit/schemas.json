      },
      "raw_output": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "type": "null"
          }
        ],
        "default": null,
        "title": "Raw Output"
      },
      "finish_reason": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "type": "null"
