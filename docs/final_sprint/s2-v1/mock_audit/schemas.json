    "type": "object"
  },
  "ExpectedHandoff": {
    "$defs": {
      "ArtifactRef": {
        "additionalProperties": false,
        "properties": {
          "artifact_id": {
            "title": "Artifact Id",
            "type": "string"
          },
          "artifact_version": {
            "title": "Artifact Version",
            "type": "integer"
          },
          "sha256": {
            "title": "Sha256",
            "type": "string"
          }
        },
        "required": [
          "artifact_id",
          "artifact_version",
          "sha256"
        ],
        "title": "ArtifactRef",
        "type": "object"
      }
    },
    "additionalProperties": false,
    "properties": {
      "handoff_id": {
        "title": "Handoff Id",
        "type": "string"
      },
      "run_id": {
        "title": "Run Id",
        "type": "string"
      },
      "upstream_node": {
        "title": "Upstream Node",
        "type": "string"
      },
      "downstream_node": {
        "title": "Downstream Node",
        "type": "string"
      },
      "required_artifact_id": {
        "title": "Required Artifact Id",
        "type": "string"
      },
      "required_artifact_version": {
        "anyOf": [
          {
            "type": "integer"
          },
          {
            "type": "null"
          }
        ],
        "title": "Required Artifact Version"
      },
      "required_artifact_hash": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "type": "null"
          }
        ],
        "title": "Required Artifact Hash"
      },
      "dependency_ids": {
        "items": {
          "type": "string"
        },
        "title": "Dependency Ids",
        "type": "array"
      },
      "branch_rule": {
        "title": "Branch Rule",
        "type": "string"
      },
      "expected": {
        "title": "Expected",
