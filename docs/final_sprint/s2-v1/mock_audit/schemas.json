      },
      "run_kind": {
        "enum": [
          "formal",
          "preflight",
          "smoke",
          "warmup",
          "debug"
        ],
        "title": "Run Kind",
        "type": "string"
      },
      "logical_task_id": {
        "title": "Logical Task Id",
        "type": "string"
      },
      "node_scope_id": {
        "title": "Node Scope Id",
        "type": "string"
      },
      "batch_id": {
        "anyOf": [
          {
            "type": "integer"
          },
          {
            "type": "null"
          }
        ],
        "title": "Batch Id"
      },
      "attempt_id": {
        "title": "Attempt Id",
        "type": "string"
      },
      "attempt_index": {
        "minimum": 1,
        "title": "Attempt Index",
        "type": "integer"
      },
      "role": {
        "title": "Role",
        "type": "string"
      },
      "task_role": {
        "title": "Task Role",
        "type": "string"
      },
      "purpose": {
        "enum": [
          "generate",
          "critic",
          "revision",
          "structure_repair"
        ],
